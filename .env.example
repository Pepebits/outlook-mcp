# Copy this file to .env and fill in OUTLOOK_CLIENT_ID.

# REQUIRED. Application (client) ID of your Azure app registration.
OUTLOOK_CLIENT_ID=

# Authority tenant: consumers (personal accounts) | organizations (work/school) | common (both) | a tenant GUID.
OUTLOOK_TENANT=consumers

# Space-separated delegated Microsoft Graph scopes.
OUTLOOK_SCOPES="User.Read Mail.ReadWrite Mail.Send offline_access"

# Path of the MSAL token cache file. Default: ~/.config/outlook-mcp/token-cache.json
OUTLOOK_TOKEN_CACHE=

# When true, every tool that changes mailbox state (send, move, delete, ...) is not registered.
OUTLOOK_READ_ONLY=false

# Directory where attachments are saved. Default: ~/Downloads
OUTLOOK_DOWNLOAD_DIR=

# Default number of messages returned by list/search tools (1-100).
OUTLOOK_DEFAULT_TOP=20

# Maximum number of characters of a message body returned by get_message.
OUTLOOK_MAX_BODY_CHARS=20000

# Microsoft Graph base URL.
OUTLOOK_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Log level written to stderr: debug | info | warn | error
LOG_LEVEL=info

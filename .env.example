# Optional: copy this file to .env in the package directory, or point OUTLOOK_ENV_FILE at it.
# A .env in the current working directory is not read.

# Optional. Application (client) ID of your own Azure app registration. Leave empty to use the shared outlook-mcp app (personal accounts).
OUTLOOK_CLIENT_ID=

# Authority tenant: consumers (personal accounts) | organizations (work/school) | common (both) | a tenant GUID.
OUTLOOK_TENANT=consumers

# Space-separated delegated Microsoft Graph scopes. Leave unset to use the defaults
# (read-write, or read-only scopes when OUTLOOK_READ_ONLY=true).
# OUTLOOK_SCOPES="User.Read Mail.ReadWrite Mail.Send MailboxSettings.ReadWrite offline_access"

# Where the token cache is stored: auto (OS keychain when available, else file) | keychain | file
OUTLOOK_TOKEN_STORE=auto

# Path of the MSAL token cache file. Default: ~/.config/outlook-mcp/token-cache.json
OUTLOOK_TOKEN_CACHE=

# When true, every tool that changes mailbox state (send, move, delete, ...) is not registered,
# the Graph client refuses non-GET requests and the default scopes are read-only.
OUTLOOK_READ_ONLY=false

# Directory where attachments are saved. Default: ~/Downloads
OUTLOOK_DOWNLOAD_DIR=

# Directories send_mail / create_draft may attach files from, separated by ':' (';' on Windows).
# Default: the download directory, ~/Documents and ~/Desktop. Hidden files are always refused.
OUTLOOK_ATTACH_DIRS=

# Default number of messages returned by list/search tools (1-100).
OUTLOOK_DEFAULT_TOP=20

# Maximum number of characters of a message body returned by get_message.
OUTLOOK_MAX_BODY_CHARS=20000

# Microsoft Graph base URL (https on a Microsoft Graph host only).
OUTLOOK_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Log level written to stderr: debug | info | warn | error
LOG_LEVEL=info
